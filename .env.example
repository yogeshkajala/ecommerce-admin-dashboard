# ─────────────────────────────────────────────────────────────────────────────
#  .env.example — Environment variable template
#
#  Copy this file to .env for local development:
#    cp .env.example .env
#
#  For Staging / Production:
#    Store the entire .env file contents as a GitHub Secret:
#      - Secret name: STAGING_ENV_FILE  (in GitHub "staging" Environment)
#      - Secret name: PROD_ENV_FILE     (in GitHub "production" Environment)
#
#  ⚠️  NEVER commit a .env file with real values.
#     .env is in .gitignore. Only .env.example is committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Container Image ──────────────────────────────────────────────────────────
GITHUB_OWNER=yogeshverma
IMAGE_TAG=latest

# ── ASP.NET Core Runtime ─────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
# Options: Development | Staging | Production

# ── SQL Server ───────────────────────────────────────────────────────────────
# Staging:    mcr.microsoft.com/mssql/server:2022-express
# Production: mcr.microsoft.com/mssql/server:2022-latest
SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-express

# SQL Server PID (edition):
# Express | Developer | Standard | Enterprise
# Express   → staging  (free, 10GB DB cap)
# Developer → local dev (full features, not for production use)
MSSQL_PID=Express

SQLSERVER_SA_PASSWORD=YourStrong@Passw0rd

# ASP.NET Core double-underscore convention maps to appsettings.json hierarchy:
# ConnectionStrings__SqlServerConnection = ConnectionStrings:SqlServerConnection
ConnectionStrings__SqlServerConnection=Server=db-sqlserver,1433;Database=EcommerceIdentity;User Id=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=True;

# Convenience alias used inside docker-compose.yml env block
SQLSERVER_CONNECTION=Server=db-sqlserver,1433;Database=EcommerceIdentity;User Id=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=True;

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=YourStrong@Passw0rd
POSTGRES_DB=EcommerceAdminCatalog

ConnectionStrings__CatalogDB=Host=db-postgres;Database=EcommerceAdminCatalog;Username=admin;Password=YourStrong@Passw0rd
POSTGRES_CONNECTION=Host=db-postgres;Database=EcommerceAdminCatalog;Username=admin;Password=YourStrong@Passw0rd

# ── Redis ─────────────────────────────────────────────────────────────────────
ConnectionStrings__RedisConnection=cache-redis:6379
REDIS_CONNECTION=cache-redis:6379

# ── Microsoft Entra (Azure AD) Authentication ─────────────────────────────────
# Maps to appsettings.json → AuthenticationConnectors:Entra:*
AuthenticationConnectors__Entra__TenantId=YOUR_TENANT_ID_HERE
AuthenticationConnectors__Entra__ClientId=YOUR_CLIENT_ID_HERE

# Aliases for docker-compose env block
ENTRA_TENANT_ID=YOUR_TENANT_ID_HERE
ENTRA_CLIENT_ID=YOUR_CLIENT_ID_HERE
